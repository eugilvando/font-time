{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Font Time",
  "version": "0.5.0",
  "identifier": "com.eugilvando.fonttime",
  "build": {
    "beforeDevCommand": "npm run vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run vite:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: asset: http://asset.localhost https://fonts.gstatic.com; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "eugilvando",
    "homepage": "https://github.com/eugilvando/font-time",
    "copyright": "AtunFrito",
    "category": "Utility",
    "shortDescription": "Gestor de fuentes para Windows",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR",
          "Spanish",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "compression": "lzma",
        "installerHooks": "nsis/hooks.nsh"
      }
    },
    "resources": {
      "../LICENSE": "LICENSE.txt",
      "../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md",
      "../licenses/*": "licenses/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY4NzY0MDczMTU4NDNBOTEKUldTUk9vUVZjMEIyYUs5Qm5tMXhUdXJsR1VDM3JxcmM0dTc1MEUvUWZUeTRLbkVxUVk5cU5ZejQK",
      "endpoints": [
        "https://github.com/eugilvando/font-time/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
